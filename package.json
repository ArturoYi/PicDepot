{
  "name": "picdepot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "deploy": "wrangler --cwd .output deploy",
    "db:migrate:local": "wrangler d1 migrations apply cf-imgbed-lite --local",
    "db:migrate:remote": "wrangler d1 migrations apply cf-imgbed-lite --remote",
    "postinstall": "nuxt prepare && wrangler types worker-configuration.d.ts",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@nuxt/ui": "^4.10.0",
    "heic-to": "^1.5.2",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.8.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.118.0"
  }
}
