# 本地开发可选配置（不会也不应提交到 Git）
# ---------------------------------------------------------------
# Cloudflare 手动部署 / 生产环境：不需要本文件。
# 请在 Dashboard 创建 D1、R2，并在 wrangler.toml / Worker vars 中配置绑定。
# ---------------------------------------------------------------

# 覆盖 Nuxt runtimeConfig.r2PublicBaseUrl（本地回退用）
NUXT_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# 覆盖单文件上限（字节）；留空则用 nuxt.config / wrangler [vars]
NUXT_MAX_UPLOAD_BYTES=

# 仅本地 / CI 调用 Wrangler / Cloudflare API 时使用；切勿写入 Worker vars 或提交仓库
# CLOUDFLARE_API_TOKEN=
